# ===========================================================================
# TikTok 跨境直播电商中台 · 环境变量示例
# ---------------------------------------------------------------------------
# 用法（Windows PowerShell）：
#   Copy-Item .env.example backend\.env
#   # 然后按需修改；backend 启动时由 dotenv 读取 backend/.env
#
# 用法（macOS / Linux）：
#   cp .env.example backend/.env
#
# 说明：所有变量都有代码内默认值，不建 .env 也能直接跑（默认 3000/8090）。
#       本机若 3000/8090 被占用，按下面「端口」一节改成 3100/8091。
# ===========================================================================

# ---------------------------------------------------------------------------
# 运行环境：development | test | production
# test 环境下会关闭请求日志，方便测试输出干净
# ---------------------------------------------------------------------------
NODE_ENV=development

# ---------------------------------------------------------------------------
# 端口
# API_PORT：后端 HTTP 服务端口（默认 3000）
# MOCK_PORT：内置的 TikTok Shop Mock 网关端口（默认 8090）
# 本机实测 3000/8090 被其他进程占用，演示时用 3100/8091
# ---------------------------------------------------------------------------
API_PORT=3000
MOCK_PORT=8090

# ---------------------------------------------------------------------------
# 数据库（SQLite 文件库；目录不存在会自动创建）
# DB_FILE：相对于 backend/ 的路径
# DB_SCHEMA_FILE / DB_SEED_FILE：建表与种子脚本（指向仓库根 db/）
# ---------------------------------------------------------------------------
DB_FILE=data/tiktok-hub.db
DB_SCHEMA_FILE=../db/schema.sql
DB_SEED_FILE=../db/seed.sql

# ---------------------------------------------------------------------------
# JWT：签发给前端后存 localStorage，Authorization: Bearer <token>
# 生产必须换成随机长串（>= 32 字节），不要提交真实密钥到仓库
# ---------------------------------------------------------------------------
JWT_SECRET=change-me-in-production-please-use-a-long-random-string
JWT_EXPIRES_IN=12h

# ---------------------------------------------------------------------------
# TikTok Shop 开放平台（默认指向内置 Mock 网关）
# 接真实平台时：TIKTOK_API_BASE=https://open-api.tiktokglobalshop.com
#              TIKTOK_APP_KEY / TIKTOK_APP_SECRET 换成企业应用凭证
# TIKTOK_TIMEOUT_MS：单次请求超时
# TIKTOK_MAX_PAGES：单次同步最多翻多少页（防止游标异常时死循环）
# TIKTOK_PAGE_SIZE：每页条数（Mock 网关会再限制成 4 以便观察游标）
# ---------------------------------------------------------------------------
TIKTOK_API_BASE=http://127.0.0.1:8090
TIKTOK_APP_KEY=tt-app-key-demo
TIKTOK_APP_SECRET=tt-app-secret-demo
TIKTOK_TIMEOUT_MS=5000
TIKTOK_MAX_PAGES=20
TIKTOK_PAGE_SIZE=50

# ---------------------------------------------------------------------------
# 金额折算：本位币（看板与结算都用它，默认人民币）
# ---------------------------------------------------------------------------
BASE_CURRENCY=CNY

# ---------------------------------------------------------------------------
# 限流：进程内固定窗口（多实例部署请换 Redis，见 docs/roadmap.md）
# ---------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=600

# ---------------------------------------------------------------------------
# 日志级别：debug | info | warn | error
# ---------------------------------------------------------------------------
LOG_LEVEL=info

# ===========================================================================
# 前端（frontend/.env.development 或构建时注入）
# ---------------------------------------------------------------------------
# 留空表示走同源 /api（vite dev 配了代理到 127.0.0.1:3000）
# 构建静态产物且后端不在 3000 端口时显式指定，例如：
#   VITE_API_BASE_URL=http://127.0.0.1:3100/api
# ===========================================================================
VITE_API_BASE_URL=
